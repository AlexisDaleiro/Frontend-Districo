{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "framework": "nestjs",
      "entrypoint": "apps/api/src/main.ts",
      "buildCommand": "npm run build -w apps/api"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_SERVICE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/internal/notifications/dispatch",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ],
  "crons": [
    {
      "path": "/api/internal/notifications/dispatch",
      "schedule": "* * * * *"
    }
  ]
}
