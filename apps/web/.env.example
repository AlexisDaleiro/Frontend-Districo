# demo o real. Nunca se cambia automáticamente cuando la API falla.
NEXT_PUBLIC_DATA_MODE=demo
# Solo para desarrollo local sin `vercel dev`; incluir /api.
# En Vercel, el binding API_SERVICE_URL se inyecta en runtime. No lo configures manualmente.
BACKEND_API_URL=http://localhost:3001/api
# Opcional y pública. Cambiar solo por un proveedor de tiles compatible.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
