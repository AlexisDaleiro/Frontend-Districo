# Real por defecto. Solo usar demo de forma explícita con `next dev` local.
# En producción, incluso un valor demo antiguo nunca activa datos simulados.
NEXT_PUBLIC_DATA_MODE=real
# Solo para desarrollo local sin `vercel dev`; incluir /api.
# En Vercel, el binding API_SERVICE_URL se inyecta en runtime. No lo configures manualmente.
BACKEND_API_URL=http://127.0.0.1:3001/api
# Opcional y pública. Cambiar solo por un proveedor de tiles compatible.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Opcional: origen público definitivo para URLs Open Graph. En Vercel se infiere de VERCEL_URL.
# SITE_URL=https://www.districo.com.uy
