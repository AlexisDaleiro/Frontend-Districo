{
  "name": "districo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend demo B2B para el e-commerce mayorista de DISTRICO S.A.",
  "scripts": {
    "catalog:import-technical-sheets": "ts-node scripts/import-technical-sheets.ts",
    "test:technical-sheets": "ts-node scripts/tests/technical-sheets.test.ts",
    "pretest": "npm run test:payment-terms && npm run test:technical-sheets",
    "payments:monitor": "ts-node scripts/enable-payment-monitor.ts",
    "test:payment-terms": "ts-node scripts/tests/payment-terms.test.ts",
    "test:payment-terms:db": "ts-node scripts/tests/payment-terms.integration.ts",
    "test:dashboard-enhancements": "ts-node scripts/tests/dashboard-enhancements.test.ts",
    "catalog:download-laboratory-logos": "node scripts/download-laboratory-logos.cjs",
    "catalog:sync-laboratory-logos": "ts-node scripts/sync-laboratory-logos.ts",
    "demo:store-taxonomy": "ts-node scripts/prepare-store-taxonomy.ts",
    "test:store-taxonomy": "ts-node scripts/tests/store-taxonomy.test.ts && ts-node scripts/tests/banner-placement.test.ts",
    "catalog:workbook-assets": "node scripts/download-workbook-assets.cjs",
    "catalog:workbook-import": "ts-node scripts/import-workbook-catalog.ts",
    "test:workbook-catalog": "ts-node scripts/tests/workbook-catalog.test.ts",
    "test:admin-tools": "ts-node scripts/tests/admin-tools.test.ts",
    "test:role-lifecycle": "ts-node scripts/tests/role-lifecycle.test.ts",
    "test:product-returns": "ts-node scripts/tests/product-returns.test.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:dashboard-enhancements && npm run test:store-taxonomy && npm run test:role-lifecycle && npm run test:product-returns && npm run test:admin-tools && npm run test:business && npm run test:catalog && npm run test:category-cleanup && npm run test:category-nesting && npm run test:organizations && npm run test:laboratory-brand-cleanup && npm run test:demo-data && npm run test:brands && npm run test:provider-demo && npm run test:presentations && npm run test:official-presentations && npm run test:presentation-plan && npm run test:variant-order && npm run test:product-queries && npm run test:catalog-images && npm run test:marketing-management && npm run test:contact-inquiries && npm run test:order-billing && npm run test:store-operations && npm run test:staff-invitations && npm run test:staff-access && npm run test:salespeople && npm run test:account-profile && npm run test:auth-security && npm run test:database-url",
    "test:laboratory-brand-cleanup": "ts-node scripts/tests/laboratory-brand-cleanup.test.ts",
    "brands:cleanup-laboratories": "ts-node scripts/cleanup-laboratory-brands.ts",
    "test:auth-security": "ts-node scripts/tests/auth-security.test.ts",
    "test:salespeople": "ts-node scripts/tests/salespeople.test.ts",
    "test:staff-access": "ts-node scripts/tests/staff-role-access.test.ts",
    "test:category-nesting": "ts-node scripts/tests/category-nesting.test.ts",
    "test:organizations": "ts-node scripts/tests/catalog-organizations.test.ts",
    "test:category-cleanup": "ts-node scripts/tests/category-cleanup.test.ts",
    "test:catalog-images": "ts-node scripts/tests/catalog-images.test.ts && ts-node scripts/tests/laboratory-logos.test.ts",
    "test:marketing-management": "ts-node scripts/tests/marketing-management.test.ts && ts-node scripts/tests/recommendation-scopes.test.ts && ts-node scripts/tests/promotion-scopes.test.ts",
    "test:database-url": "ts-node scripts/tests/database-url.test.ts",
    "test:business": "ts-node scripts/tests/business-rules.test.ts",
    "test:catalog": "ts-node scripts/tests/catalog-import.test.ts",
    "test:demo-data": "ts-node scripts/tests/demo-data.test.ts",
    "test:brands": "ts-node scripts/tests/districo-brands.test.ts && npm run test:workbook-catalog",
    "test:provider-demo": "ts-node scripts/tests/provider-demo.test.ts",
    "test:presentations": "ts-node scripts/tests/demo-presentations.test.ts",
    "test:official-presentations": "ts-node scripts/tests/official-presentations.test.ts",
    "test:presentation-plan": "ts-node scripts/tests/official-presentation-plan.test.ts",
    "test:variant-order": "ts-node scripts/tests/variant-order.test.ts",
    "test:product-queries": "ts-node scripts/tests/product-queries.test.ts && ts-node scripts/tests/admin-list-filters.test.ts",
    "test:contact-inquiries": "ts-node scripts/tests/contact-inquiries.test.ts",
    "test:order-billing": "ts-node scripts/tests/order-billing.test.ts && ts-node scripts/tests/customer-invoices.test.ts",
    "test:store-operations": "ts-node scripts/tests/store-operations.test.ts",
    "test:staff-invitations": "ts-node scripts/tests/staff-invitations.test.ts",
    "test:account-profile": "ts-node scripts/tests/account-profile.test.ts",
    "brands:sync": "ts-node scripts/sync-districo-brands.ts",
    "demo:prepare": "ts-node scripts/seed-local-demo.ts",
    "demo:providers": "ts-node scripts/seed-provider-demo.ts",
    "demo:presentations": "ts-node scripts/seed-demo-presentations.ts",
    "presentations:capture": "ts-node scripts/capture-official-presentations.ts",
    "presentations:apply": "ts-node scripts/apply-official-presentations.ts",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:check": "ts-node scripts/check-database.ts",
    "db:deploy": "prisma migrate deploy",
    "catalog:scrape": "ts-node scripts/scrape-districo.ts",
    "catalog:import": "ts-node scripts/import-districo-catalog.ts",
    "categories:cleanup": "ts-node scripts/cleanup-categories.ts",
    "categories:nest": "ts-node scripts/nest-categories.ts",
    "import:districo": "ts-node scripts/import-districo.ts",
    "import:raicor": "ts-node scripts/import-raicor.ts",
    "import:magnis": "ts-node scripts/import-magnis.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "htmlparser2": "^10.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "robots-parser": "^3.0.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
