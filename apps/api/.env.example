NODE_ENV=development
PORT=3001
HOST=127.0.0.1
# Solo para demo:prepare explicito; nunca usar estas cuentas en produccion.
DEMO_SEED_PASSWORD=
DATABASE_URL=postgresql://districo:districo@localhost:5432/districo_demo?schema=public
DIRECT_URL=postgresql://districo:districo@localhost:5432/districo_demo?schema=public
# Supabase: usar las URLs del panel Connect. Para desarrollo local IPv4,
# Session pooler (5432) puede usarse en ambas variables. Agregar sslmode=require.
# En Vercel, Prisma convierte DATABASE_URL del Session pooler a Transaction
# pooler (6543) con pgbouncer=true y connection_limit=1. También se puede
# configurar DATABASE_URL directamente con esos parámetros en el panel.
# DIRECT_URL debe seguir en Session pooler (5432), nunca Transaction pooler.
# Ver docs/DEPLOYMENT.md y SUPABASE.md.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
# Solo orígenes que accedan directamente a NestJS. El proxy web no necesita CORS.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Facturas de pedidos: bucket privado en Supabase Storage, solo backend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_INVOICE_BUCKET=order-invoices
