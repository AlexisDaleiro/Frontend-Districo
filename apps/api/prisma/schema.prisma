generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum Permission {
  CAN_VIEW_PRICES
  CAN_PLACE_ORDERS
  CAN_BUY_MEDICATIONS
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CreditStatus {
  GOOD_STANDING
  PAYMENT_DELAY
  PAYMENT_PENDING
  RESTRICTED
}

enum ProductSource {
  DISTRICO
  RAICOR
  MAGNIS
}

enum ProductType {
  FOOD
  ACCESSORY
  HYGIENE
  MEDICATION
  SUPPLEMENT
  OTHER
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum MediaType {
  IMAGE
  VIDEO
}

enum UnitOfMeasure {
  UNIT
  KG
  G
  L
  ML
}

enum StockReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum CustomerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CustomerDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  APPROVED
  PROCESSING
  SHIPPED
  DELIVERED
  REJECTED
  CANCELLED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  CROSS_DISCOUNT
  EXPIRATION_DISCOUNT
}

enum PromotionTargetType {
  PRODUCT
  PRODUCT_VARIANT
  BRAND
  CATEGORY
  LABORATORY
}

enum PromotionMetric {
  MIN_QUANTITY
  MIN_AMOUNT
}

enum PromotionRewardType {
  PERCENTAGE
  FIXED_AMOUNT
  PROMOTIONAL_PRICE
}

enum RecommendationTriggerType {
  PRODUCT
  BRAND
  CATEGORY
  LABORATORY
}

enum CampaignChannel {
  EMAIL
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

model User {
  id                String           @id @default(cuid())
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  email             String           @unique
  passwordHash      String
  role              Role             @default(CLIENT)
  active            Boolean          @default(true)
  emailVerified     Boolean          @default(false)
  permissions       UserPermission[]
  refreshTokens     RefreshToken[]
  carts             Cart[]
  priceChanges      PriceHistory[]   @relation("PriceChangedBy")
  orders            Order[]
  reviewedApplications CustomerApplication[] @relation("ApplicationReviewedBy")
  auditLogs         AuditLog[]
  createdPromotions Promotion[]       @relation("PromotionCreatedBy")
  createdCampaigns Campaign[]         @relation("CampaignCreatedBy")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model UserPermission {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission
  createdAt  DateTime   @default(now())

  @@unique([userId, permission])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model CustomerAccount {
  id                   String       @id @default(cuid())
  businessName         String
  legalName            String
  rut                  String       @unique
  phone                String?
  address              String?
  city                 String?
  department           String?
  creditStatus         CreditStatus @default(GOOD_STANDING)
  creditLimit          Decimal?     @db.Decimal(12, 2)
  internalCreditNote   String?
  accountStatus        AccountStatus @default(PENDING)
  medicationPermission Boolean      @default(false)
  users                User[]
  documents            CustomerDocument[]
  orders               Order[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Laboratory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Category {
  id        String            @id @default(cuid())
  parentId  String?
  parent    Category?         @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[]        @relation("CategoryChildren")
  name      String
  slug      String            @unique
  active    Boolean           @default(true)
  products  ProductCategory[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
}

model Product {
  id                           String                  @id @default(cuid())
  name                         String
  slug                         String                  @unique
  shortDescription             String?
  description                  String?
  productType                  ProductType             @default(OTHER)
  brandId                      String?
  brand                        Brand?                  @relation(fields: [brandId], references: [id])
  laboratoryId                 String?
  laboratory                   Laboratory?             @relation(fields: [laboratoryId], references: [id])
  source                       ProductSource           @default(DISTRICO)
  requiresMedicationPermission Boolean                 @default(false)
  active                       Boolean                 @default(true)
  featured                     Boolean                 @default(false)
  newProduct                   Boolean                 @default(false)
  tags                         String[]                @default([])
  categories                   ProductCategory[]
  variants                     ProductVariant[]
  media                        ProductMedia[]
  attributes                   ProductAttributeValue[]
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  deletedAt                    DateTime?
}

model ProductVariant {
  id                   String          @id @default(cuid())
  productId            String
  product              Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                  String          @unique
  ean                  String?         @unique
  name                 String
  presentation         String?
  weight               Decimal?        @db.Decimal(10, 3)
  unitOfMeasure        UnitOfMeasure   @default(UNIT)
  saleMultiple         Int             @default(1)
  minimumOrderQuantity Int             @default(1)
  physicalStock        Int             @default(0)
  reservedStock        Int             @default(0)
  active               Boolean         @default(true)
  isDemoData           Boolean         @default(false)
  media                ProductMedia[]
  prices               Price[]
  priceHistory         PriceHistory[]
  cartItems            CartItem[]
  stockReservations    StockReservation[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?
}

model PriceList {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  prices    Price[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Price {
  id               String         @id @default(cuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  priceListId      String
  priceList        PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @default("UYU")
  validFrom        DateTime       @default(now())
  validUntil       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([productVariantId, priceListId, validFrom])
}

model PriceHistory {
  id               String         @id @default(cuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  previousPrice    Decimal?       @db.Decimal(12, 2)
  newPrice         Decimal        @db.Decimal(12, 2)
  currency         String         @default("UYU")
  changedById      String?
  changedBy        User?          @relation("PriceChangedBy", fields: [changedById], references: [id])
  changedAt        DateTime       @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  reservations StockReservation[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId])
}

model CartItem {
  id               String         @id @default(cuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  quantity         Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([cartId, productVariantId])
}

model StockReservation {
  id         String                 @id @default(cuid())
  variantId  String
  variant    ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  cartId     String?
  cart       Cart?                  @relation(fields: [cartId], references: [id], onDelete: SetNull)
  orderId    String?
  order      Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quantity   Int
  status     StockReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime               @default(now())
  releasedAt DateTime?
  consumedAt DateTime?

  @@index([status, expiresAt])
  @@index([variantId])
}

model CustomerApplication {
  id                            String                    @id @default(cuid())
  businessName                  String
  legalName                     String
  rut                           String
  contactName                   String?
  phone                         String?
  email                         String
  passwordHash                  String
  address                       String?
  department                    String?
  city                          String?
  businessType                  String?
  requestedMedicationPermission Boolean                   @default(false)
  status                        CustomerApplicationStatus @default(PENDING)
  reviewedById                  String?
  reviewedBy                    User?                     @relation("ApplicationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt                    DateTime?
  rejectionReason               String?
  documents                     CustomerDocument[]
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([rut])
}

model CustomerDocument {
  id                String                 @id @default(cuid())
  customerAccountId String?
  customerAccount   CustomerAccount?       @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  applicationId     String?
  application       CustomerApplication?   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type              String
  fileUrl           String
  originalName      String
  mimeType          String
  status            CustomerDocumentStatus @default(PENDING)
  expirationDate    DateTime?
  uploadedAt        DateTime               @default(now())
}

model Order {
  id                   String             @id @default(cuid())
  orderNumber          String             @unique
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  customerAccountId    String?
  customerAccount      CustomerAccount?   @relation(fields: [customerAccountId], references: [id])
  status               OrderStatus        @default(SUBMITTED)
  requiresManualReview Boolean            @default(false)
  reviewReason         String?
  acceptedManualReview Boolean            @default(false)
  subtotal             Decimal            @db.Decimal(12, 2)
  discountTotal        Decimal            @db.Decimal(12, 2)
  total                Decimal            @db.Decimal(12, 2)
  currency             String             @default("UYU")
  items                OrderItem[]
  reservations         StockReservation[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  variantId   String
  productName String
  variantName String
  sku         String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount    Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}

model Promotion {
  id          String               @id @default(cuid())
  name        String
  description String?
  active      Boolean              @default(true)
  type        PromotionType
  startsAt    DateTime
  endsAt      DateTime?
  priority    Int                  @default(0)
  combinable  Boolean              @default(false)
  createdById String?
  createdBy   User?                @relation("PromotionCreatedBy", fields: [createdById], references: [id])
  conditions  PromotionCondition[]
  rewards     PromotionReward[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  @@index([active, startsAt, endsAt])
}

model PromotionCondition {
  id          String              @id @default(cuid())
  promotionId String
  promotion   Promotion           @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  targetType  PromotionTargetType
  targetId    String?
  metric      PromotionMetric     @default(MIN_QUANTITY)
  minQuantity Int?
  minAmount   Decimal?            @db.Decimal(12, 2)
}

model PromotionReward {
  id          String              @id @default(cuid())
  promotionId String
  promotion   Promotion           @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  targetType  PromotionTargetType
  targetId    String?
  rewardType  PromotionRewardType
  percentage  Decimal?            @db.Decimal(5, 2)
  amount      Decimal?            @db.Decimal(12, 2)
}

model ExpirationPromotion {
  id                 String   @id @default(cuid())
  productId          String?
  variantId          String?
  batch              String?
  expirationDate     DateTime
  discountPercentage Decimal? @db.Decimal(5, 2)
  promotionalPrice   Decimal? @db.Decimal(12, 2)
  startsAt           DateTime
  endsAt             DateTime?
  quantityLimit      Int?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RecommendationRule {
  id                String                    @id @default(cuid())
  name              String
  active            Boolean                   @default(true)
  priority          Int                       @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  triggerType       RecommendationTriggerType
  triggerId         String
  minimumQuantity   Int?
  minimumCartAmount Decimal?                  @db.Decimal(12, 2)
  products          RecommendationRuleProduct[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model RecommendationRuleProduct {
  id          String             @id @default(cuid())
  ruleId      String
  rule        RecommendationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  productId   String
  variantId   String?
  position    Int                @default(0)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model NotificationLog {
  id        String   @id @default(cuid())
  event     String
  recipient String?
  payload   Json?
  provider  String   @default("console")
  createdAt DateTime @default(now())
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  channel     CampaignChannel
  status      CampaignStatus @default(DRAFT)
  content     String
  scheduledAt DateTime?
  createdById String?
  createdBy   User?          @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model AttributeDefinition {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  type      AttributeType    @default(SELECT)
  values    AttributeValue[]
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model AttributeValue {
  id          String                  @id @default(cuid())
  attributeId String
  attribute   AttributeDefinition     @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  slug        String
  products    ProductAttributeValue[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([attributeId, slug])
}

model ProductAttributeValue {
  productId        String
  attributeValueId String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
}

model ProductMedia {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      MediaType        @default(IMAGE)
  url       String
  alt       String?
  position  Int              @default(0)
  isPrimary Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}
